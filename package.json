{
  "name": "ecole-ia-desktop",
  "productName": "École IA",
  "version": "1.0.0",
  "description": "Application de bureau Windows : tableau de bord de la plateforme éducative avec Agent IA",
  "main": "electron/main.js",
  "author": "École IA",
  "homepage": "https://example.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix student-frontend install",
    "front:install": "npm --prefix student-frontend install",
    "front:build": "npm --prefix student-frontend run build",
    "dev": "concurrently -k \"npm --prefix student-frontend run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "start": "npm run front:build && electron .",
    "dist:win": "npm run front:build && electron-builder --win --x64",
    "dist:linux": "npm run front:build && electron-builder --linux deb --x64"
  },
  "build": {
    "appId": "com.ecole.ia.desktop",
    "productName": "École IA",
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "student-frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Education",
      "maintainer": "École IA"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  }
}
